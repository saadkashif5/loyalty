NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/taptapsell_dev
# Optional in development (in-memory fallback); required in staging and production.
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGINS=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
# Platform console origin, for the team's password reset links
ADMIN_URL=http://localhost:3001

# Email: "log" prints to the console in development; staging/production need smtp.
EMAIL_TRANSPORT=log
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=TapTapSell <no-reply@example.com>

# Shared with web/ and admin/ so they can pass on the user's IP. Required in staging/production.
INTERNAL_API_SECRET=

# 32 random bytes, base64. Required in staging and production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Local testing only: skips two-step verification. Refused in staging and production.
# SKIP_MFA=true
MFA_ENCRYPTION_KEY=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Error tracking (leave empty in development)
SENTRY_DSN=

# Private uploads (payment receipts) until cloud storage is set up
STORAGE_DIR=./storage
