NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/taptapsell_dev
# Optional in development (in-memory fallback); required in staging and production.
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Production values (see docs/environments.md):
#   CORS_ORIGINS=https://business.stamply.taptapsell.pk,https://admin.stamply.taptapsell.pk,https://stamply.taptapsell.pk
#   DASHBOARD_URL=https://business.stamply.taptapsell.pk
#   ADMIN_URL=https://admin.stamply.taptapsell.pk
CORS_ORIGINS=http://localhost:3000
# Business dashboard origin, for invitation, activation and password reset links
DASHBOARD_URL=http://localhost:3000
# Platform console origin, for the team's password reset links
ADMIN_URL=http://localhost:3001

# Email: "log" prints to the console in development; staging/production need smtp.
EMAIL_TRANSPORT=log
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
# Production: Stamply <no-reply@stamply.taptapsell.pk> (the domain needs SPF/DKIM for the SMTP provider)
EMAIL_FROM=Stamply <no-reply@example.com>

# Shared with web/ and admin/ so they can pass on the user's IP. Required in staging/production.
INTERNAL_API_SECRET=

# 32 random bytes, base64. Required in staging and production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Local testing only: skips two-step verification. Refused in staging and production.
# SKIP_MFA=true
MFA_ENCRYPTION_KEY=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Error tracking (leave empty in development)
SENTRY_DSN=

# Request tracing to any OTLP/HTTP collector (Tempo, Honeycomb, Jaeger). Unset = off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=taptapsell

# Private uploads (payment receipts) until cloud storage is set up
STORAGE_DIR=./storage
