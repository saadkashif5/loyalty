API_BASE_URL=http://localhost:4000/api/v1

# Error tracking (leave empty in development)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Same value as the API's INTERNAL_API_SECRET; lets the API rate-limit per user.
INTERNAL_API_SECRET=
# Header your host sets to the real client IP (e.g. cf-connecting-ip). Leave empty to use
# the last X-Forwarded-For entry.
CLIENT_IP_HEADER=
