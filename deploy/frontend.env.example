# Copy to deploy/frontend.env on the server. Used by web, admin and portal.
# API_BASE_URL is set in docker-compose.yml (the API's private address).

# Same value as INTERNAL_API_SECRET in api.env.
INTERNAL_API_SECRET=

# Leave empty while Caddy faces the internet directly. Set to cf-connecting-ip
# only if you turn on the Cloudflare proxy (orange cloud).
CLIENT_IP_HEADER=

# Optional
SENTRY_DSN=
