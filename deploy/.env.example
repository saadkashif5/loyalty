# Copy to deploy/.env on the server. Read by docker compose itself.

# Where the images live: ghcr.io/<github-owner>/<repo>, all lowercase.
IMAGE_PREFIX=ghcr.io/your-github-user/loyalty
# Image tag to run. The deploy workflow passes the commit SHA; "latest" is the newest main.
TAG=latest

# The portal host. The others are business., admin. and api. in front of it.
DOMAIN=stamply.taptapsell.pk
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com
