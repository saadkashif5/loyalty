# Copy to deploy/api.env on the server and fill in every value.
# Used by the api and worker containers. REDIS_URL, PORT and STORAGE_DIR are set in
# docker-compose.yml. Generate each secret with:  openssl rand -base64 48

NODE_ENV=production

# MongoDB Atlas connection string (Connect > Drivers). Include the database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/stamply?retryWrites=true&w=majority

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Same value in frontend.env.
INTERNAL_API_SECRET=

# Exactly 32 random bytes, base64:  openssl rand -base64 32
# Keep a copy somewhere safe: losing it means everyone sets up two-step verification again.
MFA_ENCRYPTION_KEY=

CORS_ORIGINS=https://stamply.taptapsell.pk,https://business.stamply.taptapsell.pk,https://admin.stamply.taptapsell.pk
DASHBOARD_URL=https://business.stamply.taptapsell.pk
ADMIN_URL=https://admin.stamply.taptapsell.pk

# Brevo example. The login contains "@": write it as %40.
#   smtp://xxxxxx%40smtp-brevo.com:SMTP_KEY@smtp-relay.brevo.com:587
EMAIL_TRANSPORT=smtp
SMTP_URL=
EMAIL_FROM=Stamply <no-reply@stamply.taptapsell.pk>

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Optional
SENTRY_DSN=
